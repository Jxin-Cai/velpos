# =============================================================================
# Velpos — Production Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# Prod mode: everything runs in Docker (MySQL + backend + frontend/nginx).
# Claude configuration (API key, model, base URL) is managed via the UI's
# Channel Profile feature, which persists to ~/.claude/settings.json.
# =============================================================================

# --- Runtime / authentication ---
# Production startup fails until all blank secrets are provided.
VELPOS_MODE=pro
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
VELPOS_ADMIN_PASSWORD=
VELPOS_REGISTRATION_ENABLED=false

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=velpos

# --- Ports ---
APP_PORT=80

# --- User workspaces ---
# Docker Compose expands ${HOME}; a literal tilde (~) is not expanded.
# Layout: ~/velpos/{user_id}/agents and ~/velpos/{user_id}/teams
PROJECTS_HOST_DIR=${HOME}/velpos

# --- Agent runtime ---
CLAUDE_PERMISSION_MODE=acceptEdits

# --- CORS ---
# Empty is the secure same-origin default. Set a comma-separated allowlist only
# when the frontend and API are served from different origins.
CORS_ALLOW_ORIGINS=
